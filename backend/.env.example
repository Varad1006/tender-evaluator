# Copy to backend/.env and fill in the keys:  cp backend/.env.example backend/.env
# backend/.env is git-ignored; never commit real keys.

# --- Credentials ------------------------------------------------------------
# Datalab (Chandra OCR) — https://www.datalab.to  (leave empty to run without OCR)
DATALAB_API_KEY=your-datalab-api-key
# Gemini (optional LLM-assisted extraction; leave empty to disable)
GEMINI_API_KEY=

# --- OCR tuning (defaults shown) ------------------------------------------------
TE_OCR_MODE_SCANNED=balanced
TE_OCR_MODE_VECTOR=fast
TE_OCR_MAX_CONCURRENCY=4
TE_OCR_REQUESTS_PER_MINUTE=10
TE_OCR_BATCH_PAGES=10
TE_OCR_MAX_PAGES_PER_TENDER=150
TE_OCR_MAX_PAGES_PER_BIDDER=300

# --- Storage and limits (defaults shown) -----------------------------------------
# TE_DATA_DIR=./data
# TE_DATABASE_URL=sqlite:///./data/poc.db
# TE_OCR_CACHE_DIR=./data/ocr_cache
TE_MAX_FILE_SIZE_MB=200
TE_MAX_BIDDERS_SOFT_LIMIT=20
TE_LLM_EXTRACTION_TIMEOUT_SECS=45

# --- OpenRouter (grounded reading + verdict stage) --------------------------------
# https://openrouter.ai/keys — leave empty to run fully deterministic (no reading stage)
OPENROUTER_API_KEY=
# Workhorse reader, and the model a negative verdict must be confirmed on before it stands.
TE_MODEL_READER=google/gemini-2.5-flash
TE_MODEL_CRITICAL=anthropic/claude-sonnet-4.5
# Hard ceiling for one evaluation run; the stage stops and degrades to deterministic.
TE_LLM_MAX_SPEND_USD=1.00
