{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["TE_API_URL=http://127.0.0.1:8010", "npm", "--prefix", "frontend", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    }
  ]
}
